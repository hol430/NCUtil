<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <ProjectReference Include="../NCUtil.Core/NCUtil.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyNativeLib" AfterTargets="Build">
    <Message Text="Copying native lib to target directory..." Importance="Normal" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../mpibridge/mpibridge.so" DestinationFolder="$(TargetDir)/" />
  </Target>

</Project>
